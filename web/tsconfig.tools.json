{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist-types/tools",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-types/tsconfig.tools.tsbuildinfo",
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "release/smoke.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "scripts/test"
  ],
  "references": [
    {
      "path": "./backend"
    }
  ]
}
