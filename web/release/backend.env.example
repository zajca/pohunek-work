# Required: the NetBird address of this host. Wildcard binds are rejected.
POHUNEK_BACKEND_BIND_HOST=

# Required: the TCP port that browsers on the NetBird network will use.
POHUNEK_BACKEND_PORT=

# Optional: use a non-default local daemon socket.
# POHUNEK_BACKEND_DAEMON_SOCKET=

# Optional: seconds a starting backend waits for the local daemon (default 60;
# 0 tries once) and the pause between attempts (default 1).
# POHUNEK_BACKEND_DAEMON_WAIT=
# POHUNEK_BACKEND_DAEMON_RETRY_INTERVAL=
