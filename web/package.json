{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "backend",
    "client-core",
    "frontend"
  ],
  "catalog": {
    "@pohunek/protocol": "https://github.com/zajca/pohunek/releases/download/v0.32.1/pohunek-ts-protocol-0.32.1.tgz",
    "@pohunek/sdk": "https://github.com/zajca/pohunek/releases/download/v0.32.1/pohunek-ts-sdk-0.32.1.tgz",
    "@pohunek/testkit": "https://github.com/zajca/pohunek/releases/download/v0.32.1/pohunek-ts-testkit-0.32.1.tgz"
  },
  "scripts": {
    "core-sdk:sync": "bun scripts/sync-core-sdk.ts",
    "core-sdk:pack": "bun scripts/pack-core-sdk.ts",
    "core-sdk:serve": "bun scripts/serve-core-sdk.ts",
    "core-sdk:install": "bun scripts/serve-core-sdk.ts --run bun install --frozen-lockfile",
    "dev": "bun run scripts/dev.ts",
    "build:frontend": "cd frontend && bun run build",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "eslint \"**/*.{ts,svelte}\" --max-warnings=0",
    "test": "bun test",
    "test:e2e": "bun run build:frontend && bun ./node_modules/@playwright/test/cli.js test --config frontend/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@pohunek/backend": "workspace:*",
    "@pohunek/protocol": "catalog:",
    "@pohunek/sdk": "catalog:",
    "@pohunek/testkit": "catalog:",
    "@types/bun": "1.3.11",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "3.22.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.1.5"
  }
}
