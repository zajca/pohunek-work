#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/lib.sh"

# Pick one of *my* actionable issues in rofi and start work on it in a terminal.
# The issue source is chosen per invocation (there is no default):
#   linear  rows come from the Linear CLI; the selection goes to
#           pohunek-launch-issue, which renders the prompt template and creates
#           the session.
#   github  rows come from `pohunek-work list --json` (the project's
#           github-issue rows that offer `implement`); the selection runs
#           `pohunek-work do <key> implement`, so prompt and session-link
#           metadata are the plugin's.
# Kept separate from `pohunek-rofi` (the running-session switcher): that one
# attaches to existing sessions, this one starts a new one from a work item, so
# they earn their own keybinds.

usage="usage: pohunek-rofi-issue <project> <linear|github> [action]"
[ "$#" -ge 2 ] && [ "$#" -le 3 ] || pohunek_fail "$usage"
project="$1"
issue_source="$2"
case "$issue_source" in
  linear) action="${3:-process-issue}" ;;
  github)
    action="${3:-implement}"
    [ "$action" = "implement" ] || pohunek_fail "the github source only starts the 'implement' action; $usage"
    ;;
  *) pohunek_fail "unknown issue source '$issue_source'; $usage" ;;
esac

rofi_bin="$(pohunek_optional_config rofi_bin rofi)"
terminal_bin="$(pohunek_optional_config terminal "${TERMINAL:-}")"
[ -n "$terminal_bin" ] || pohunek_fail "missing terminal config key and TERMINAL is unset"
pohunek_need_cmd "$rofi_bin"
pohunek_need_cmd python3

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/pohunek-rofi-issue.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
rows_file="$tmp_dir/rows"

if [ "$issue_source" = "linear" ]; then
  linear_cli="$(pohunek_required_config linear_cli)"
  # Which Linear workflow-state *types* count as "actionable". Space-separated;
  # valid values mirror `linear issue query --state`: triage backlog unstarted
  # started completed canceled.
  states="$(pohunek_optional_config linear_issue_states 'started unstarted')"
  # Assignee (Linear display name) whose issues are listed. Empty = derive from
  # the authenticated user so a fresh install needs no manual step.
  assignee="$(pohunek_optional_config linear_assignee '')"
  pohunek_need_cmd "$linear_cli"

  # Resolve the assignee. An explicit config value wins; otherwise derive it from
  # the authenticated user. Fail fast (never silently widen to *everyone's*
  # issues) if neither yields a name.
  if [ -z "$assignee" ]; then
    assignee="$(pohunek_linear_assignee "$linear_cli")"
  fi
  [ -n "$assignee" ] || pohunek_fail "cannot determine Linear assignee; set 'linear_assignee' in launcher.conf"

  # Build the query: one --state flag per configured state. The unquoted $states
  # expansion is the intended word-split of the space-separated state list.
  set -- "$linear_cli" issue query --all-teams --assignee "$assignee" --sort priority --json
  for state in $states; do
    set -- "$@" --state "$state"
  done
  issues_json="$("$@")"

  # Render "identifier<TAB>state<TAB>title" rows. The identifier flows into a later
  # argv to pohunek-launch-issue (and, downstream, into sway criteria via session
  # ids), so restrict it to a safe charset here — Linear ids look like "ABC-123",
  # so this rejects nothing legitimate while refusing anything carrying a
  # metacharacter. The state column lets the user narrow by typing it in rofi.
  python3 - "$issues_json" >"$rows_file" <<'PY'
import json
import re
import sys


def flatten(value):
    # rofi rows are one-per-line, tab-delimited; flatten embedded control chars
    # so a crafted field cannot inject an extra row or forge a column.
    text = value if isinstance(value, str) else ""
    return text.replace("\t", " ").replace("\n", " ").replace("\r", " ")


SAFE = re.compile(r"^[A-Za-z0-9._-]+$")
data = json.loads(sys.argv[1])
items = data if isinstance(data, list) else (data.get("issues") or data.get("nodes") or [])
for item in items:
    if not isinstance(item, dict):
        continue
    ident = item.get("identifier") or item.get("id")
    if not isinstance(ident, str) or not SAFE.match(ident):
        continue
    state = item.get("state")
    if isinstance(state, dict):
        state_name = state.get("name") or state.get("type") or "-"
    elif isinstance(state, str) and state:
        state_name = state
    else:
        state_name = "-"
    print(f"{ident}\t{flatten(state_name)}\t{flatten(item.get('title'))}")
PY
  prompt_label="linear issue"
else
  work_bin="$(pohunek_required_config pohunek_work_bin)"
  pohunek_need_cmd "$work_bin"

  # `list` exits 3 when a source was unavailable but still prints the envelope;
  # the rows below are then whatever the available sources returned, and the
  # reason is on stderr. Any other non-zero status is a failure, reported below
  # with the error envelope's message when there is one.
  list_file="$tmp_dir/list.json"
  list_status=0
  "$work_bin" list --json --project "$project" >"$list_file" || list_status=$?

  # Render "key<TAB>state<TAB>title" rows of the project's github-issue rows that
  # offer `implement` (`do` plans it exactly then). The key flows into the
  # terminal argv of `pohunek-work do`, so it must match the strict
  # github-issue:<owner>/<name>#<n> charset; a row that does not is dropped.
  # The envelope must be an `ok` payload of a list contract this picker reads.
  python3 - "$list_file" "$list_status" >"$rows_file" <<'PY'
import json
import re
import sys

# `list --json` contract versions this picker understands.
SUPPORTED_LIST_CONTRACT = 4


def flatten(value):
    text = value if isinstance(value, str) else ""
    return text.replace("\t", " ").replace("\n", " ").replace("\r", " ")


def fail(message):
    raise SystemExit(f"pohunek: pohunek-work list: {message}")


LIST_STATUS = int(sys.argv[2])
KEY = re.compile(r"^github-issue:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+#[0-9]+$")
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        envelope = json.load(handle)
except (OSError, json.JSONDecodeError) as exc:
    if LIST_STATUS not in (0, 3):
        fail(f"failed with exit status {LIST_STATUS}")
    fail(f"output is not valid JSON: {exc}")
if not isinstance(envelope, dict):
    fail("output is not a JSON object")
if "err" in envelope:
    err = envelope["err"]
    detail = flatten(err.get("msg")) if isinstance(err, dict) else ""
    fail(f"reported an error: {detail or 'no message'}")
if LIST_STATUS not in (0, 3):
    fail(f"failed with exit status {LIST_STATUS}")
protocol = envelope.get("protocol")
low = protocol.get("minimum") if isinstance(protocol, dict) else None
high = protocol.get("maximum") if isinstance(protocol, dict) else None
if not isinstance(low, int) or not isinstance(high, int) or not low <= SUPPORTED_LIST_CONTRACT <= high:
    fail(f"contract {low}..{high} does not include supported version {SUPPORTED_LIST_CONTRACT}")
payload = envelope.get("ok")
items = payload.get("items") if isinstance(payload, dict) else None
if not isinstance(items, list):
    fail("envelope has no ok.items list")
for item in items:
    if not isinstance(item, dict):
        continue
    key = item.get("key")
    if not isinstance(key, str) or not KEY.match(key):
        continue
    actions = item.get("actions")
    if not isinstance(actions, list) or not any(isinstance(a, dict) and a.get("name") == "implement" for a in actions):
        continue
    issue = item.get("issue")
    state = flatten(issue.get("state")) if isinstance(issue, dict) else ""
    title = flatten(issue.get("title")) if isinstance(issue, dict) else ""
    print(f"{key}\t{state or '-'}\t{title}")
PY
  prompt_label="github issue"
fi

# No issues (or all filtered out): nothing to launch.
[ -s "$rows_file" ] || exit 0

# Show the distinct states present as a hint, so the user knows what to type to
# narrow the list (rofi matches against the whole row, state column included).
states_present="$(cut -f2 "$rows_file" | sort -u | paste -sd ',' - | sed 's/,/, /g')"

selection_file="$tmp_dir/selection"
if ! "$rofi_bin" -dmenu -p "$prompt_label" -mesg "states: $states_present" <"$rows_file" >"$selection_file"; then
  # Non-zero from rofi means the user dismissed it (Esc); start nothing.
  exit 0
fi
selection="$(cat "$selection_file")"
[ -n "$selection" ] || exit 0

# Take the identifier (first tab-separated field) and re-validate before handing
# it to the launch command — defence in depth against a hand-typed rofi entry.
issue_id="$(printf '%s\n' "$selection" | cut -f1)"
# grep matches per line, so a multi-line value must be refused before the pattern check.
case "$issue_id" in
  *'
'*) pohunek_fail "invalid issue selection: more than one line" ;;
esac
if [ "$issue_source" = "linear" ]; then
  printf '%s' "$issue_id" | grep -Eq '^[A-Za-z0-9._-]+$' || pohunek_fail "invalid issue id: $issue_id"
  set -- "$script_dir/pohunek-launch-issue" "$project" "$issue_id" "$action"
else
  printf '%s' "$issue_id" | grep -Eq '^github-issue:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+#[0-9]+$' || pohunek_fail "invalid issue key: $issue_id"
  # `do` asks for confirmation on the terminal (no --yes), so the plan is shown.
  set -- "$work_bin" do "$issue_id" "$action" --project "$project"
fi

# Run the launch in a terminal: it may prompt for confirmation (needs a tty), and
# the user — who triggered this from a keybind with no controlling terminal —
# should see the created-session id (or any error). Keep the window open after it
# finishes so a fast local create does not just flash and vanish.
"$terminal_bin" -e sh -c '
  "$@"
  status=$?
  printf "\n[pohunek] launch finished (exit %s); press Enter to close..." "$status"
  read _ignored
  exit "$status"
' sh "$@" &

exit 0
