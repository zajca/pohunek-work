#!/bin/sh
# Write the MANIFEST of a release archive staging directory.
#
# usage: write-manifest [--core <ref>] <staging-dir> <component> <version> <target> <signing> [<minimum-macos>]
#
# The manifest names the archive's component, version, target triple, signing
# state, the pinned core version when `--core` gives one (a release tag
# `vX.Y.Z` or a 40-digit commit, see `packaging/core-pin`), and the SHA-256 of
# every regular file below the staging directory, so the installer can prove
# that what it is about to install is complete, intact, and built for this host
# before it changes anything. It is the last step of assembling an archive:
# signing and bundle assembly come first because the hashes cover the final
# bytes.
#
# <signing> is `none` for archives without a signing step (Linux), `adhoc` for
# a macOS archive whose Mach-O files and app bundles carry an ad-hoc signature,
# and `unsigned-development` for a local macOS build that must not be
# distributed.
# <minimum-macos> is required for an `apple-darwin` target and refused for any
# other.

set -eu

fail() {
    printf 'write-manifest: %s\n' "$*" >&2
    exit 1
}

usage="usage: write-manifest [--core <ref>] <staging-dir> <component> <version> <target> <signing> [<minimum-macos>]"
core_ref=
if [ "${1:-}" = --core ]; then
    [ "$#" -ge 2 ] || fail "$usage"
    core_ref=$2
    shift 2
    case $core_ref in
        v[0-9]*.[0-9]*.[0-9]*)
            case ${core_ref#v} in
                *[!0-9.]*) fail "core ref must be vX.Y.Z or a 40-digit commit: $core_ref" ;;
            esac
            ;;
        *[!0-9a-f]* | '') fail "core ref must be vX.Y.Z or a 40-digit commit: $core_ref" ;;
        *) [ "${#core_ref}" -eq 40 ] || fail "core ref must be vX.Y.Z or a 40-digit commit: $core_ref" ;;
    esac
fi
if [ "$#" -ne 5 ] && [ "$#" -ne 6 ]; then
    fail "$usage"
fi
staging=$1
component=$2
version=$3
target=$4
signing=$5
minimum_macos=${6:-}

case $component in
    gui | web | launchers) ;;
    *) fail "unsupported component: $component" ;;
esac
case $version in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) fail "version must be X.Y.Z: $version" ;;
esac
case $version in
    *[!0-9.]*) fail "version must be X.Y.Z: $version" ;;
esac
case $target in
    '' | *[!a-z0-9_-]*) fail "target must be a lowercase target triple: $target" ;;
esac
case $signing in
    none | adhoc | unsigned-development) ;;
    *) fail "unsupported signing state: $signing" ;;
esac
case $target in
    *-apple-darwin)
        [ -n "$minimum_macos" ] || fail "an apple-darwin target needs <minimum-macos>"
        case $minimum_macos in
            [0-9]*.[0-9]* | [0-9]*) ;;
            *) fail "minimum-macos must be numeric: $minimum_macos" ;;
        esac
        case $minimum_macos in
            *[!0-9.]*) fail "minimum-macos must be numeric: $minimum_macos" ;;
        esac
        ;;
    *)
        [ -z "$minimum_macos" ] || fail "<minimum-macos> applies only to an apple-darwin target"
        ;;
esac
[ -d "$staging" ] || fail "not a directory: $staging"

# Prints the SHA-256 of $1, or fails: a missing tool, an unreadable file, or
# anything but 64 hex digits never yields a manifest entry.
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sum=$(sha256sum -- "$1") || return 1
    elif command -v shasum >/dev/null 2>&1; then
        sum=$(shasum -a 256 -- "$1") || return 1
    else
        return 1
    fi
    sum=${sum%% *}
    case $sum in
        *[!0-9a-f]* | '') return 1 ;;
    esac
    [ "${#sum}" -eq 64 ] || return 1
    printf '%s\n' "$sum"
}

cd "$staging"
rm -f -- MANIFEST
trap 'rm -f -- MANIFEST.tmp' EXIT

if [ -n "$(find . -type l -print)" ]; then
    fail "the staging directory contains a symbolic link: $(find . -type l -print | head -n 1)"
fi
if [ -n "$(find . ! -type f ! -type d -print)" ]; then
    fail "the staging directory contains a special file: $(find . ! -type f ! -type d -print | head -n 1)"
fi

list=$(find . -type f -print | LC_ALL=C sort)
[ -n "$list" ] || fail "the staging directory has no files"

{
    printf 'pohunek-archive-manifest 1\n'
    printf 'component %s\n' "$component"
    printf 'version %s\n' "$version"
    printf 'target %s\n' "$target"
    printf 'signing %s\n' "$signing"
    if [ -n "$core_ref" ]; then
        printf 'core %s\n' "$core_ref"
    fi
    if [ -n "$minimum_macos" ]; then
        printf 'minimum-macos %s\n' "$minimum_macos"
    fi
    printf '%s\n' "$list" | while IFS= read -r path; do
        path=${path#./}
        # The installer parses one path per line and quotes nothing, so a
        # path outside this alphabet is refused instead of escaped.
        case $path in
            '' | *[!A-Za-z0-9._+@=,/-]*) fail "unsupported character in archive path: $path" ;;
        esac
        digest=$(sha256_of "$path") || fail "cannot compute the SHA-256 of $path"
        printf 'sha256 %s %s\n' "$digest" "$path"
    done
} > MANIFEST.tmp
mv -- MANIFEST.tmp MANIFEST
chmod 0644 MANIFEST
