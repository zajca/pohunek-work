#!/bin/sh
# Assemble the staging directory of one release archive.
#
# usage: stage-archive <component> <version> <target> <input> <output-dir>
#
# <component> is web, launchers, or plugin. <input> is the built input of that
# component: the input tree assembled by web/release/package.sh, the `launchers/`
# source directory, or the repository root for the plugin (its sources import
# files from `launchers/`, so the archive keeps the `plugin/` and `launchers/`
# sibling layout). The staging directory <output-dir>/<name> is created fresh and the archive name
# `<prefix>-<version>-<target>` is printed on stdout. Run from the repository
# root: the README and the license texts are copied from it.
#
# Nothing here signs or hashes. Signing, `write-manifest`, and `archive` run
# afterwards, in that order, because the manifest covers the final bytes.

set -eu

fail() {
    printf 'stage-archive: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 5 ] || fail "usage: stage-archive <component> <version> <target> <input> <output-dir>"
component=$1
version=$2
target=$3
input=$4
output=$5

case $component in
    web) prefix=pohunek-web ;;
    launchers) prefix=pohunek-launchers ;;
    plugin) prefix=pohunek-work-plugin ;;
    *) fail "unsupported component: $component" ;;
esac
case $version in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) fail "version must be X.Y.Z: $version" ;;
esac
case $version in
    *[!0-9.]*) fail "version must be X.Y.Z: $version" ;;
esac
case $target in
    '' | *[!a-z0-9_-]*) fail "target must be a lowercase target triple: $target" ;;
esac
[ -d "$input" ] || fail "not a directory: $input"
mkdir -p "$output"
[ -d "$output" ] || fail "not a directory: $output"
[ -f README.md ] || fail "required release file is missing: README.md (run from the repository root)"
[ -d LICENSES ] || fail "required release directory is missing: LICENSES (run from the repository root)"
[ -f packaging/verify-archive ] || fail "packaging/verify-archive is missing (run from the repository root)"

name="$prefix-$version-$target"
staging="$output/$name"
rm -rf -- "$staging"
mkdir -p "$staging"

copy_member() {
    [ -f "$input/$1" ] || fail "required input file is missing: $input/$1"
    mkdir -p "$staging/$(dirname -- "$1")"
    cp "$input/$1" "$staging/$1"
}

case $component in
    web)
        # The web archive is assembled by web/release/package.sh; <input> is
        # its input tree (backend executable, frontend, installer, README).
        [ -f "$input/pohunek-web" ] || fail "required input file is missing: $input/pohunek-web"
        cp -Rp "$input/." "$staging/"
        mkdir -p "$staging/packaging"
        cp packaging/verify-archive "$staging/packaging/"
        ;;
    launchers)
        # The scripts the launcher setup installs, their default configuration
        # and prompt templates, and the two guides.
        for member in lib.sh pohunek-launch-issue pohunek-launch-pr pohunek-rofi pohunek-rofi-issue \
            templates/launcher.conf templates/sway-dropin.conf.tmpl \
            templates/prompts/issue.tmpl templates/prompts/pr.tmpl \
            docs/launcher.md docs/debug-launcher.md; do
            copy_member "$member"
        done
        ;;
    plugin)
        # The CLI sources and prompt templates, and the launcher files that
        # `plugin/src/setup/assets.ts` imports as text.
        for member in plugin/package.json plugin/tsconfig.json plugin/README.md; do
            copy_member "$member"
        done
        [ -d "$input/plugin/src" ] || fail "required input directory is missing: $input/plugin/src"
        [ -d "$input/plugin/prompts" ] || fail "required input directory is missing: $input/plugin/prompts"
        members=$(cd "$input" && find plugin/src plugin/prompts -type f | LC_ALL=C sort)
        [ -n "$members" ] || fail "the plugin input has no source files"
        for member in $members; do
            copy_member "$member"
        done
        for member in lib.sh pohunek-launch-issue pohunek-launch-pr pohunek-rofi pohunek-rofi-issue \
            templates/launcher.conf templates/sway-dropin.conf.tmpl templates/sway-issue-binding.conf.tmpl \
            templates/prompts/issue.tmpl templates/prompts/pr.tmpl; do
            copy_member "launchers/$member"
        done
        ;;
esac

cp -R LICENSES "$staging/LICENSES"
# The web input tree carries its own README (the installer guide).
if [ "$component" != web ]; then
    cp README.md "$staging/"
fi

printf '%s\n' "$name"
