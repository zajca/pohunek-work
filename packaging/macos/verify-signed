#!/bin/sh
# Verify the ad-hoc signatures of an archive staging directory.
#
# usage: verify-signed --adhoc <staging-dir>
#
# Every bare Mach-O file and every app bundle must pass
# `codesign --verify --strict` (bundles with `--deep`) and carry an ad-hoc
# signature (`Signature=adhoc`). An unsigned item, a signature that does not
# verify, and a certificate-signed item (any `Authority=` line, which only a
# certificate chain produces) all fail: the archive's `signing adhoc` claim must describe
# exactly what is inside. Every problem is reported before the exit status 1.

set -eu

fail() {
    printf 'verify-signed: %s\n' "$*" >&2
    exit 2
}

usage="usage: verify-signed --adhoc <staging-dir>"
[ "$#" -eq 2 ] || fail "$usage"
[ "$1" = --adhoc ] || fail "$usage"
staging=$2
[ -d "$staging" ] || fail "not a directory: $staging"
for tool in codesign od find; do
    command -v "$tool" >/dev/null 2>&1 || fail "required tool not found: $tool"
done

failures=0
checked=0
problem() {
    printf 'FAIL %s: %s\n' "$1" "$2" >&2
    failures=$((failures + 1))
}

is_macho() {
    case $(od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' \n') in
        cffaedfe | cafebabe | bebafeca | feedfacf | cefaedfe | feedface | cafebabf | bfbafeca) return 0 ;;
        *) return 1 ;;
    esac
}

scratch=$(mktemp -d "${TMPDIR:-/tmp}/pohunek-verify.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

# Checks the signature of $1; the remaining arguments are extra codesign
# verify options.
check_signature() {
    target=$1
    shift
    if ! codesign --verify --strict --verbose=2 "$@" "$target" 2>"$scratch/verify"; then
        problem "$target" "code signature does not verify: $(tr '\n' ' ' < "$scratch/verify")"
        return
    fi
    if ! codesign -dvv "$target" >"$scratch/details" 2>&1; then
        problem "$target" "codesign cannot describe it"
        return
    fi
    if grep -q '^Authority=' "$scratch/details"; then
        problem "$target" "signed with a certificate, not ad-hoc"
        return
    fi
    if ! grep -q '^Signature=adhoc' "$scratch/details"; then
        problem "$target" "not ad-hoc signed"
        return
    fi
    checked=$((checked + 1))
}

find "$staging" -type d -name '*.app' -prune -print | LC_ALL=C sort > "$scratch/apps"
find "$staging" -type f -print | LC_ALL=C sort > "$scratch/files"
while IFS= read -r file; do
    inside_app=no
    while IFS= read -r app; do
        case $file in
            "$app"/*) inside_app=yes ;;
        esac
    done < "$scratch/apps"
    [ "$inside_app" = no ] || continue
    is_macho "$file" || continue
    check_signature "$file"
done < "$scratch/files"
while IFS= read -r app; do
    [ -n "$app" ] || continue
    check_signature "$app" --deep
done < "$scratch/apps"

if [ "$checked" -eq 0 ] && [ "$failures" -eq 0 ]; then
    printf 'verify-signed: no Mach-O file or app bundle found below %s\n' "$staging" >&2
    exit 1
fi
if [ "$failures" -ne 0 ]; then
    printf 'verify-signed: %s problem(s)\n' "$failures" >&2
    exit 1
fi
printf 'verify-signed: %s ad-hoc signed item(s) verified\n' "$checked"
