#!/bin/sh
# Package built macOS binaries into a release-layout archive.
#
# usage:
#   package --development   <component> <version> <bindir> <output-dir>
#   package --stage-release <component> <version> <bindir> <output-dir>
#   package --adhoc-release <component> <version> <staging-dir>
#
# <component> is gui or web (the gui archive holds Pohunek.app, built here from
# <bindir>/pohunek-gui by native/packaging/macos/build-app-bundle; for web,
# <bindir> is the input tree of
# `web/release/package.sh <version> aarch64-apple-darwin --input-only`). The
# staged tree is audited (`audit-macho`), then sealed with a MANIFEST and
# archived reproducibly; the archive path is printed on stdout.
#
# A release is made in two steps so that the tree is assembled and signed on
# separate runners. `--stage-release` assembles and audits the tree and prints
# the staging directory. `--adhoc-release` then ad-hoc signs every Mach-O file
# and app bundle of the tree (`sign`), verifies the result
# (`verify-signed --adhoc`), and writes the manifest and the archive, so the
# manifest hashes the final signed bytes and records `signing adhoc`. It audits
# the tree again before signing (the tree came from another runner) and runs
# nothing from it. An ad-hoc signature uses no certificate and no keychain, so
# the step needs no credential.
#
# `--development` builds an unsigned archive for local use and CI acceptance
# (an app bundle gets only an ad-hoc seal so it can launch). Its name ends in
# `-unsigned-development` and its MANIFEST says `signing unsigned-development`,
# so it can never be mistaken for a release artifact and is never attached to a
# release.
#
# The MANIFEST records the pinned core version from POHUNEK_CORE_REF
# (`packaging/core-pin`); the release modes fail when it is unset, the
# development mode records it only when set.
#
# `SOURCE_DATE_EPOCH` stamps the archive; it defaults to the commit time of
# HEAD. Run from anywhere inside the repository on an arm64 Mac.

set -eu

fail() {
    printf 'package: %s\n' "$*" >&2
    exit 1
}

usage="usage: package --development|--stage-release <component> <version> <bindir> <output-dir>
       package --adhoc-release <component> <version> <staging-dir>"
[ "$#" -ge 1 ] || fail "$usage"
mode=$1
case $mode in
    --development | --stage-release) [ "$#" -eq 5 ] || fail "$usage" ;;
    --adhoc-release) [ "$#" -eq 4 ] || fail "$usage" ;;
    *) fail "unsupported mode: $mode
$usage" ;;
esac
component=$2
version=$3
case $component in
    gui) require="--require Pohunek.app/Contents/MacOS/pohunek-gui" ;;
    web) require="--require pohunek-web --no-string-scan" ;;
    *) fail "unsupported component: $component" ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
root=$(CDPATH= cd -- "$script_dir/../.." && pwd -P)
target=aarch64-apple-darwin
minimum_macos=$(tr -d ' \n' < "$root/native/packaging/macos/DEPLOYMENT_TARGET")
core_ref=${POHUNEK_CORE_REF:-}
if [ "$mode" != --development ] && [ -z "$core_ref" ]; then
    fail "POHUNEK_CORE_REF is not set: a release archive records the pinned core version"
fi

# write_manifest <staging-dir> <signing>
write_manifest() {
    if [ -n "$core_ref" ]; then
        sh "$root/packaging/write-manifest" --core "$core_ref" "$1" "$component" "$version" "$target" "$2" "$minimum_macos"
    else
        sh "$root/packaging/write-manifest" "$1" "$component" "$version" "$target" "$2" "$minimum_macos"
    fi
}

if [ "$mode" = --adhoc-release ]; then
    staging=$(CDPATH= cd -- "$4" && pwd -P)
    output=$(dirname -- "$staging")
    name=$(basename -- "$staging")
    case $name in
        *-unsigned-development) fail "a development staging directory cannot be signed as a release: $name" ;;
        "pohunek-$component-$version-$target") ;;
        *) fail "unexpected staging directory name: $name" ;;
    esac
    cd "$root"
    if [ -z "${SOURCE_DATE_EPOCH:-}" ]; then
        SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)
    fi
    export SOURCE_DATE_EPOCH
    # The tree arrives from another runner, so what is about to be signed is
    # checked again here: only regular files and directories, and every
    # program a Mach-O file of the right platform, architecture, and target.
    unexpected=$(find "$staging" ! -type f ! -type d -print | head -n 1)
    [ -z "$unexpected" ] || fail "the staged tree holds a symbolic link or special file: $unexpected"
    # shellcheck disable=SC2086
    "$script_dir/audit-macho" $require --forbid-string "$root" "$staging" >&2
    "$script_dir/sign" "$staging" >&2
    "$script_dir/verify-signed" --adhoc "$staging" >&2
    write_manifest "$staging" adhoc
    sh "$root/packaging/archive" "$output" "$name" "$output"
    printf '%s\n' "$output/$name.tar.gz"
    exit 0
fi

bindir=$4
output=$5
# The caller's relative paths mean the caller's directory.
bindir=$(CDPATH= cd -- "$bindir" && pwd -P)
output=$(CDPATH= cd -- "$output" && pwd -P)

cd "$root"
if [ -z "${SOURCE_DATE_EPOCH:-}" ]; then
    SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)
fi
export SOURCE_DATE_EPOCH

work=$(mktemp -d "${TMPDIR:-/tmp}/pohunek-package.XXXXXX")
trap 'rm -rf -- "$work"' EXIT
if [ "$component" = gui ]; then
    "$root/native/packaging/macos/build-app-bundle" "$bindir/pohunek-gui" "$version" "$work" > /dev/null
    bindir=$work
fi

name=$("$root/packaging/stage-archive" "$component" "$version" "$target" "$bindir" "$output")
if [ "$mode" = --development ]; then
    suffix=-unsigned-development
    rm -rf -- "$output/$name$suffix"
    mv -- "$output/$name" "$output/$name$suffix"
    name=$name$suffix
fi
staging=$output/$name

if [ "$mode" = --development ] && [ "$component" = gui ]; then
    # Apple Silicon kills an app whose bundle seal is invalid. An ad-hoc seal
    # (no identity, no trust) lets a development bundle launch; the manifest
    # still says `unsigned-development`.
    codesign --force --sign - "$staging/Pohunek.app" >&2
    codesign --verify --strict --deep "$staging/Pohunek.app" >&2
fi

# The Bun runtime embedded in the web backend carries its own build paths, so
# its string scan is skipped through $require.
# shellcheck disable=SC2086
"$script_dir/audit-macho" $require --forbid-string "$root" "$staging" >&2
if [ "$mode" = --stage-release ]; then
    printf '%s\n' "$staging"
    exit 0
fi
write_manifest "$staging" unsigned-development
sh "$root/packaging/archive" "$output" "$name" "$output"
printf '%s\n' "$output/$name.tar.gz"
