#!/usr/bin/env python3
"""Resolve the pohunek core version every surface is pinned to.

usage: core-pin [--web PATH]

The single source of the pin is web/core-sdk.json. It must exist, be valid, and
be internally consistent (the same rules as `web/scripts/core-sdk.ts`). Prints
`key=value` lines (usable with `>> "$GITHUB_OUTPUT"`):

  core_ref        the core release tag `vX.Y.Z` when the pin names one, else
                  the 40-digit commit
  core_rev        the 40-digit core commit
  web_version     the web surface version from web/package.json

web/core-sdk.json (see web/scripts/core-sdk.ts) holds `coreRepository`,
`coreRev`, `sdkVersion` and `assetBaseUrl`. When `assetBaseUrl` is the core
repository's GitHub release download URL, the pin also names the release tag
`v<sdkVersion>` and that tag must resolve, with `git ls-remote`, to `coreRev`.
When `assetBaseUrl` is anything else (the loopback server used before a core
release), no tag is named and no network step runs.

The pin is refused, with exit status 1, when
  - web/core-sdk.json is missing or malformed,
    names a repository that is not a GitHub `owner/repo`, or names a release
    tag that does not point at its `coreRev`;
  - web/package.json is missing or has an invalid web version;
  - the pinned core repository cannot be listed with `git ls-remote`.

Python 3.8 or newer, standard library only.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import urlsplit

TAG = re.compile(r"^v[0-9]+\.[0-9]+\.[0-9]+$")
COMMIT = re.compile(r"^[0-9a-f]{40}$")
SDK_VERSION = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$")
VERSION = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$")
WEB_KEYS = ("coreRepository", "coreRev", "sdkVersion", "assetBaseUrl")
RELEASE_DOWNLOAD_PATH = "/releases/download"
LOOPBACK_HOST = "127.0.0.1"


class PinError(Exception):
    """The pin is missing, malformed, or inconsistent."""


def repo_slug(url: str) -> str | None:
    """`owner/name` of a GitHub clone URL, None for any other host."""
    match = re.fullmatch(r"https://github\.com/([^/]+/[^/]+)", url)
    return match.group(1) if match else None


def read_web(path: Path) -> tuple[str, str | None, str]:
    """Returns (core commit, release tag or None, git URL for tag resolution)."""
    if not path.is_file():
        raise PinError(f"{path} does not exist")
    try:
        pin = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise PinError(f"cannot read {path}: {error}") from error
    if not isinstance(pin, dict) or sorted(pin) != sorted(WEB_KEYS):
        raise PinError(f"{path} must be an object with exactly the keys {', '.join(WEB_KEYS)}")
    for key in WEB_KEYS:
        if not isinstance(pin[key], str) or not pin[key]:
            raise PinError(f"{path}: {key} must be a non-empty string")
    web_repo = repo_slug(pin["coreRepository"])
    if web_repo is None:
        raise PinError(f"{path}: coreRepository must be https://github.com/<owner>/<repo>")
    if not COMMIT.match(pin["coreRev"]):
        raise PinError(f"{path}: coreRev must be a 40-digit lowercase commit: {pin['coreRev']}")
    if not SDK_VERSION.match(pin["sdkVersion"]):
        raise PinError(f"{path}: sdkVersion must be a semantic version: {pin['sdkVersion']}")
    try:
        base = urlsplit(pin["assetBaseUrl"])
    except ValueError as error:
        raise PinError(f"{path}: invalid assetBaseUrl: {error}") from error
    if not base.scheme or not base.netloc:
        raise PinError(f"{path}: assetBaseUrl is not an absolute URL: {pin['assetBaseUrl']}")
    if base.username or base.password or base.query or base.fragment:
        raise PinError(f"{path}: assetBaseUrl must not carry credentials, a query or a fragment")
    try:
        port = base.port
    except ValueError as error:
        raise PinError(f"{path}: invalid assetBaseUrl port: {error}") from error
    if base.scheme == "http":
        if base.hostname != LOOPBACK_HOST or port is None or base.path != RELEASE_DOWNLOAD_PATH:
            raise PinError(f"{path}: an http assetBaseUrl must be http://{LOOPBACK_HOST}:<port>{RELEASE_DOWNLOAD_PATH}")
        return pin["coreRev"], None, pin["coreRepository"]
    if base.scheme != "https" or base.netloc != "github.com" or base.path != f"/{web_repo}{RELEASE_DOWNLOAD_PATH}":
        raise PinError(f"{path}: an https assetBaseUrl must be the release download URL of {pin['coreRepository']}")
    tag = f"v{pin['sdkVersion']}"
    if not TAG.match(tag):
        raise PinError(f"{path}: a release assetBaseUrl needs a plain X.Y.Z sdkVersion: {pin['sdkVersion']}")
    return pin["coreRev"], tag, pin["coreRepository"]


def resolve_tag(git: str, tag: str) -> str:
    """The commit a tag points at (the peeled commit for an annotated tag)."""
    try:
        result = subprocess.run(
            ["git", "ls-remote", "--", git, f"refs/tags/{tag}", f"refs/tags/{tag}^{{}}"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as error:
        raise PinError(f"cannot run git ls-remote: {error}") from error
    if result.returncode != 0:
        raise PinError(f"cannot list tags of {git}: {result.stderr.strip()}")
    commits = {}
    for line in result.stdout.splitlines():
        commit, ref = line.split("\t", 1)
        commits[ref] = commit
    commit = commits.get(f"refs/tags/{tag}^{{}}") or commits.get(f"refs/tags/{tag}")
    if commit is None or not COMMIT.match(commit):
        raise PinError(f"core tag {tag} does not exist in {git}")
    return commit


def read_web_version(path: Path) -> str:
    try:
        package = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise PinError(f"cannot read {path}: {error}") from error
    version = package.get("version") if isinstance(package, dict) else None
    if not isinstance(version, str) or not VERSION.fullmatch(version):
        raise PinError(f"{path} must declare a version X.Y.Z, got: {version!r}")
    return version


def resolve(web: Path) -> dict[str, str]:
    rev, tag, repository = read_web(web)
    version = read_web_version(web.parent / "package.json")
    if tag is not None:
        resolved = resolve_tag(repository, tag)
        if resolved != rev:
            raise PinError(f"web pins core {tag} = {resolved}, but its coreRev is {rev}")
    return {"core_ref": tag or rev, "core_rev": rev, "web_version": version}


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--web", type=Path, default=Path("web/core-sdk.json"))
    args = parser.parse_args(argv)
    try:
        pin = resolve(args.web)
    except PinError as error:
        print(f"core-pin: {error}", file=sys.stderr)
        return 1
    for key, value in pin.items():
        print(f"{key}={value}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
