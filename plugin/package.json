{
  "name": "pohunek-work",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "Pohunek workflow plugin: who is on turn for each work item",
  "bin": {
    "pohunek-work": "src/main.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/private-tmpdir.ts bun test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/react": "19.2.14",
    "eslint": "^10.11.0",
    "typescript": "6",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@pohunek/protocol": "https://github.com/zajca/pohunek/releases/download/v0.34.2/pohunek-ts-protocol-0.34.2.tgz",
    "@pohunek/sdk": "https://github.com/zajca/pohunek/releases/download/v0.34.2/pohunek-ts-sdk-0.34.2.tgz",
    "fzf": "0.5.2",
    "ink": "7.1.1",
    "react": "19.2.4",
    "react-devtools-core": "7.0.1"
  },
  "patchedDependencies": {
    "ink@7.1.1": "patches/ink@7.1.1.patch"
  }
}
