#!/usr/bin/env bash
# Builds the pohunek core binaries the integration tests drive (pohunekd,
# pohunek-sessiond, pohunek) from the core revision pinned in native/Cargo.toml
# and prints the environment variables that locate them.
#
# Usage: eval "$(scripts/build-core-binaries [install-root])"
set -euo pipefail

native_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manifest="$native_dir/Cargo.toml"

rev="$(sed -n 's/^pohunek-protocol = .*rev = "\([0-9a-f]\{40\}\)".*/\1/p' "$manifest")"
repo="$(sed -n 's/^pohunek-protocol = .*git = "\([^"]*\)".*/\1/p' "$manifest")"
[[ -n "$rev" && -n "$repo" ]] || {
  echo "build-core-binaries: no pinned core git rev found in $manifest" >&2
  exit 1
}

root="${1:-${POHUNEK_CORE_INSTALL_ROOT:-$native_dir/target/core-binaries/$rev}}"

# The binaries are installed from the exact revision with the lockfile of that
# revision. `--debug` keeps the build short; the tests do not depend on
# optimization.
cargo install --locked --debug --git "$repo" --rev "$rev" --root "$root" \
  pohunek-daemon pohunek-session-worker pohunek-cli >&2

echo "export POHUNEK_DAEMON_BIN='$root/bin/pohunekd'"
echo "export POHUNEK_WORKER_BIN='$root/bin/pohunek-sessiond'"
echo "export POHUNEK_CLI_BIN='$root/bin/pohunek'"
