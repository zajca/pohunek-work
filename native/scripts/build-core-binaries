#!/usr/bin/env bash
# Builds the pohunek core binaries the integration tests drive (pohunekd,
# pohunek-sessiond, pohunek) from the core release pinned in native/Cargo.toml
# and prints the environment variables that locate them.
#
# Usage: eval "$(scripts/build-core-binaries [install-root])"
set -euo pipefail

native_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manifest="$native_dir/Cargo.toml"

line="$(grep '^pohunek-protocol = ' "$manifest")"
repo="$(sed -n 's/.*git = "\([^"]*\)".*/\1/p' <<<"$line")"
tag="$(sed -n 's/.*tag = "\([^"]*\)".*/\1/p' <<<"$line")"
rev="$(sed -n 's/.*rev = "\([0-9a-f]\{40\}\)".*/\1/p' <<<"$line")"
if [[ -n "$tag" ]]; then
  ref_flag=(--tag "$tag"); ref="$tag"
else
  ref_flag=(--rev "$rev"); ref="$rev"
fi
[[ -n "$ref" && -n "$repo" ]] || {
  echo "build-core-binaries: no pinned core git tag or rev found in $manifest" >&2
  exit 1
}

root="${1:-${POHUNEK_CORE_INSTALL_ROOT:-$native_dir/target/core-binaries/$ref}}"

# The binaries are installed from the exact pinned release (or revision) with
# the lockfile of that source. `--debug` keeps the build short; the tests do not
# depend on optimization.
cargo install --locked --debug --git "$repo" "${ref_flag[@]}" --root "$root" \
  pohunek-daemon pohunek-session-worker pohunek-cli >&2

echo "export POHUNEK_DAEMON_BIN='$root/bin/pohunekd'"
echo "export POHUNEK_WORKER_BIN='$root/bin/pohunek-sessiond'"
echo "export POHUNEK_CLI_BIN='$root/bin/pohunek'"
